# 템플릿. 값이 없는 외부 연동은 P0에 필요하지 않습니다.
# 설정 로더는 서버에서 읽으며, 이 파일에 실제 비밀값을 넣지 않습니다.
DATA_MODE=demo
# DATA_MODE=real 전환 시 data/real 또는 별도 비공개 경로를 지정합니다.
DATA_DIR=data/demo
PARSER_MODE=rules
EXPLANATION_MODE=template
MAP_MODE=off
POLICY_PATH=config/policy.v2.json
GEMINI_APPROVAL_PATH=config/gemini_approval_plan.json
DEMO_NOW=2026-09-19T18:00:00+09:00
DATABASE_URL=sqlite:///./var/consumer_compass_demo.db
# 실데이터 예: DATABASE_URL=sqlite:///./var/consumer_compass_real.db
ALLOW_EXTERNAL_CALLS=false
ALLOW_PAID_CALLS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Gemini 연결 준비용 서버 전용 변수. 승인 파일·데이터 API 게이트·두 스위치가 모두 통과해야 호출합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=5000
# GOOGLE_API_KEY는 다른 프로젝트 키의 암묵적 우선 사용을 막기 위해 이 앱에서 사용하지 않습니다.
PUBLIC_DATA_API_KEY=
# 아래 값만 브라우저 공개 가능. 서비스 비밀키를 VITE_ 변수에 넣지 않습니다.
VITE_API_BASE_URL=http://localhost:8000
VITE_KAKAO_MAP_JS_KEY=
